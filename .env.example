# ===== Gemini =====
# 從 https://aistudio.google.com/apikey 取得
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ===== 推播管道 (預設 Telegram) =====
# NOTIFIER 可選：telegram / console
NOTIFIER=telegram

# Telegram：用 @BotFather 建立 bot 取得 token；chat_id 可用 @userinfobot 查詢
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ===== 抓取設定 =====
# 每個來源最多抓幾則
MAX_ITEMS_PER_FEED=8
# 最終整理後推播的則數
MAX_DIGEST_ITEMS=6
# 只抓最近幾小時內的新聞
LOOKBACK_HOURS=36
